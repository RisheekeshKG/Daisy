# Copy this file to .env and fill in the values you need.
#
#   Development:  put it in the project root (next to package.json).
#   Installed app: put it in your per-user config directory instead —
#                  macOS   ~/Library/Application Support/Daisy/.env
#                  Windows %APPDATA%\Daisy\.env
#                  Linux   ~/.config/Daisy/.env
# Every integration is optional and degrades gracefully when unset — Daisy
# runs fine with none of these, just with less to talk about.

# --- Daisy AI chat (Google Gemini) -----------------------------------------
# https://aistudio.google.com/apikey
# Missing/invalid key: the agent falls back to a local rule-based mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Google Calendar + Gmail (shared OAuth connection) ----------------------
# https://console.cloud.google.com/apis/credentials — create an OAuth client
# (type: Desktop app), enable the Calendar API and Gmail API.
# Connecting Calendar also authorizes Gmail; there is no separate Gmail login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Spotify Connect ---------------------------------------------------------
# https://developer.spotify.com/dashboard — create an app, add
# http://127.0.0.1:8000/api/spotify/callback as a redirect URI.
SPOTIFY_CLIENT_ID=
