{
  "name": "daisy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "backend:setup": "node scripts/setup-backend.mjs",
    "backend:build": "node scripts/build-backend.mjs",
    "backend:dev": "node scripts/py.mjs -m uvicorn main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "backend:test": "node scripts/py.mjs -m pytest backend/tests -q",
    "start": "npm run build && cross-env DAISY_SERVE_STATIC=1 node scripts/py.mjs -m uvicorn main:app --app-dir backend --host 127.0.0.1 --port 8000",
    "electron:dev": "concurrently -k -n VITE,ELECTRON \"cross-env DISABLE_HMR=false npm run dev\" \"wait-on http://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "electron:build": "npm run build && npm run backend:build && electron-builder",
    "electron:pack": "npm run build && npm run backend:build && electron-builder --dir",
    "icon": "electron scripts/render-icon.cjs assets/icon/icon.svg assets/icon/icon.png 1024"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.daisy.app",
    "productName": "Daisy",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "assets/icon/icon.png"
    ],
    "extraResources": [
      {
        "from": "backend/dist/daisy-backend",
        "to": "backend"
      },
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Daisy listens for your voice so you can talk to your assistant."
      },
      "icon": "assets/icon/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon/icon.png"
    },
    "icon": "assets/icon/icon.icns",
    "publish": [
      {
        "provider": "github",
        "owner": "RisheekeshKG",
        "repo": "Daisy"
      }
    ]
  },
  "productName": "Daisy",
  "license": "MIT",
  "author": "Risheekesh K G"
}
